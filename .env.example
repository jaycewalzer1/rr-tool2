# Copy to .env and fill in. Every variable without a default is required
# unless FLASK_ENV=testing, in which case dummy values are substituted.

# development | testing | production
FLASK_ENV=development
LOG_LEVEL=DEBUG

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Used for absolute URLs in Stripe redirects when not behind a proxy.
APP_BASE_URL=http://localhost:5000

# SQLAlchemy connection string.
DATABASE_URL=sqlite:///app.db

# --- AWS Cognito (authentication) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# --- AWS S3 (uploaded PDFs and generated workbooks) ---
# Credentials come from the instance role in production; set these only for local runs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME_PDF=
S3_BUCKET_NAME_EXCEL=

# --- Stripe (subscriptions) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
# Required: unverified webhooks would let anyone grant themselves a subscription.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=

# --- Google Maps (optional; the map page degrades without it) ---
GOOGLE_MAPS_API_KEY=
